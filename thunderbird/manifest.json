{
  "manifest_version": 2,
  "name": "Organizer",
  "version": "1.8",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "Organizer",
  "browser_specific_settings": {
    "gecko": { "id": "thunderbird@organizer.local", "strict_min_version": "128.0" }
  },
  "icons": { "64": "icon.png" },
  "permissions": ["compose", "messagesRead", "accountsRead", "storage", "notifications", "menus"],
  "optional_permissions": ["*://*/*"],
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "options.html" }
}
